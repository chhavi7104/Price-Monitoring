# ============================================================
# Price Monitor - Environment Configuration Template
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file to version control.
# ============================================================

# --- Browser / Playwright settings ---
HEADLESS=true                 # true = run browser without a visible window
BROWSER_TYPE=chromium         # chromium | firefox | webkit
NAVIGATION_TIMEOUT_MS=30000    # max time to wait for a page to load
DEFAULT_WAIT_MS=5000           # default explicit wait for elements

# --- Monitoring settings ---
PRODUCTS_FILE=config/products.json   # list of products to track
CHECK_INTERVAL_MINUTES=60            # used only in --loop / scheduled mode
PRICE_DROP_THRESHOLD_PERCENT=5       # trigger an alert if price drops >= 5%

# --- Storage ---
DATA_DIR=data
SCREENSHOTS_DIR=screenshots
LOGS_DIR=logs
CSV_EXPORT_FILE=data/price_history.csv

# --- Email notifications (optional, bonus feature) ---
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
ALERT_EMAIL_FROM=your_email@gmail.com
ALERT_EMAIL_TO=recipient@example.com
